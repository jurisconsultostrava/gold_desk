# ===== Runtime =====
NODE_ENV=production
PORT=5000
MAILROOM_USER_ID=default-user
MAILROOM_ENCRYPTION_KEY=

# ===== Supabase backend =====
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=mailroom-attachments

# ===== AI provider =====
# Recommended low-cost default:
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_MODEL_CLASSIFY=gemini:gemini-2.5-flash
AI_MODEL_DRAFT=gemini:gemini-2.5-flash
AI_MODEL_QA=gemini:gemini-2.5-flash
GEMINI_API_KEY=

# Optional alternatives
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# ===== Gmail OAuth =====
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://YOUR-RAILWAY-DOMAIN/api/auth/gmail/callback

# ===== Microsoft / Outlook OAuth =====
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=https://YOUR-RAILWAY-DOMAIN/api/auth/outlook/callback

# Datová schránka / ISDS PHP bridge
PHP_BINARY=php
ISDS_CACHE_DIR=/tmp/GoldDeskDataBox
DATABOX_BRIDGE_PATH=/app/scripts/databox_bridge.php


# ===== Vstupní autentizace do aplikace =====
# Doporučeno pro Railway/public deploy. Pokud je APP_AUTH_ENABLED=true,
# musí být nastavené APP_AUTH_USERNAME a buď APP_AUTH_PASSWORD, nebo APP_AUTH_PASSWORD_HASH.
APP_AUTH_ENABLED=true
APP_AUTH_USERNAME=admin
APP_AUTH_PASSWORD=change-this-strong-password
# Bezpečnější varianta místo APP_AUTH_PASSWORD:
# APP_AUTH_PASSWORD_HASH=scrypt:...
# Vygenerování hashe: npm run auth:hash -- "moje-silne-heslo"
APP_SESSION_SECRET=change-this-long-random-session-secret
# Na Railway/HTTPS ponechat true. Pokud testuješ lokálně v production přes http, dej false.
APP_COOKIE_SECURE=true
APP_SESSION_MAX_AGE_MS=43200000
